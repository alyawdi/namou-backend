# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Path to the SQLite database file (created on first migrate)
DATABASE_URL=./data/shop.db

# Comma-separated list of browser origins allowed to call the API directly.
# The Next.js frontend proxies /api/* so this is only needed for direct access.
CORS_ORIGINS=http://localhost:3000

# Session lifetime in days
SESSION_TTL_DAYS=7

# Credentials of the seeded demo user
SEED_USER_EMAIL=demo@namou.shop
SEED_USER_PASSWORD=Demo@12345
SEED_USER_NAME=Demo User
